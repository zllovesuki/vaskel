{
  "name": "vaskel",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "i18n:compile": "pnpm --filter @vaskel/client run i18n:compile",
    "dev": "pnpm --filter @vaskel/client run dev",
    "dev:site": "pnpm --filter @vaskel/site run dev",
    "dev:setup": "pnpm --filter @vaskel/server run dev:setup",
    "db:migrate:local": "pnpm --filter @vaskel/server run db:migrate:local",
    "db:migrate:staging": "pnpm --filter @vaskel/server run db:migrate:staging",
    "build": "pnpm --filter @vaskel/client run build",
    "build:staging": "pnpm --filter @vaskel/client run build:staging",
    "build:site": "pnpm --filter @vaskel/site run build",
    "deploy:staging": "pnpm run build:staging && wrangler deploy --config apps/client/dist/vaskel/wrangler.json --tag \"$(git rev-parse --short HEAD)\" --message \"$(git log -1 --format='%h %s')\"",
    "deploy:production": "CLOUDFLARE_ENV=production pnpm run build && wrangler deploy --config apps/client/dist/vaskel/wrangler.json --tag \"$(git rev-parse --short HEAD)\" --message \"$(git log -1 --format='%h %s')\"",
    "deploy:site": "pnpm run build:site && wrangler deploy --config apps/site/wrangler.jsonc",
    "types": "pnpm --filter @vaskel/server run types",
    "typecheck": "pnpm --filter @vaskel/contracts run typecheck && pnpm --filter @vaskel/ui run typecheck && pnpm --filter @vaskel/client run typecheck && pnpm --filter @vaskel/server run typecheck && pnpm --filter @vaskel/site run typecheck && tsc -p tsconfig.json && tsc -p tsconfig.browser.json",
    "lint": "eslint .",
    "format": "prettier --write \"{apps,packages,tests,tools}/**/*.{ts,tsx,js,mjs,json,jsonc,css,html,md}\" \"*.{json,jsonc,ts,mjs,yaml,yml}\"",
    "format:check": "prettier --check \"{apps,packages,tests,tools}/**/*.{ts,tsx,js,mjs,json,jsonc,css,html,md}\" \"*.{json,jsonc,ts,mjs,yaml,yml}\"",
    "test": "vitest run",
    "test:unit": "vitest run --project client-unit --project server-unit --project site-unit --project ui-unit",
    "test:build": "vitest run --config vitest.build.config.ts",
    "test:browser": "playwright test",
    "test:browser:measure": "playwright test --config playwright.measure.config.ts",
    "test:browser:site": "playwright test --config playwright.site.config.ts",
    "test:runtime": "vitest run --project server-runtime",
    "brand": "node tools/brand.ts",
    "api:export": "node tools/export-api.mjs"
  },
  "devDependencies": {
    "@babel/core": "8.0.5",
    "@babel/eslint-parser": "8.0.5",
    "@cloudflare/vitest-plugin": "1.1.10",
    "@vaskel/contracts": "workspace:*",
    "@vaskel/ui": "workspace:*",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "prettier": "3.9.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vite": "8.3.0",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  },
  "packageManager": "pnpm@11.1.0"
}
