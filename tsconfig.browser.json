{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "vite/client"],
    "paths": {
      "@tests/shared/*": ["./tests/helpers/*"],
      "@tests/*": ["./tests/*"],
      "@/client/*": ["./apps/client/src/*"]
    },
    "jsx": "react-jsx",
    // Wrangler/Miniflare tooling declarations have private workspace imports.
    "skipLibCheck": true
  },
  "include": ["playwright*.config.ts", "tests/e2e", "tests/site"]
}
