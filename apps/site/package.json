  "dependencies": {
    "@vaskel/contracts": "workspace:*",
    "@vaskel/ui": "workspace:*",
    "lucide-react": "1.46.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "tailwindcss": "4.3.3",
    "vite": "8.3.0",
    "vitest": "4.1.11",
    "wrangler": "4.132.0"
  }
}
